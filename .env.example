PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/timeora
# 32+ random characters: openssl rand -base64 48
AUTH_SECRET=replace-with-a-long-random-secret-value
# Comma-separated list of frontend origins allowed by CORS
FRONTEND_URL=http://localhost:3000,http://localhost:3002
ADMIN_URL=http://localhost:3002
# Number of reverse proxies in front of this server (the Next.js rewrite counts as 1)
TRUST_PROXY=1
# SMTP settings required for password-reset emails
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Used only by `npm run seed` to create the first admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-please
# Optional Razorpay Test Mode credentials from the Razorpay dashboard (key ID must start with rzp_test_)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
